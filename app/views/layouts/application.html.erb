<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Local Show HN" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Local Show HN">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <meta name="description" content="Show HN projects tied to a specific city, town or county, on a map, listed like the HN front page.">
    <%= auto_discovery_link_tag :atom, feed_url, title: "Local Show HN" %>
    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="page">
      <header class="site-header">
        <%= link_to root_path, class: "logo", "aria-label": "Local Show HN" do %>L<% end %>
        <nav>
          <%= link_to "Local Show HN", root_path, class: "brand" %>
          <%= link_to "new", root_path, class: ("current" if controller_name == "posts" && params[:sort] != "top") %> |
          <%= link_to "top", root_path(sort: "top"), class: ("current" if params[:sort] == "top") %> |
          <%= link_to "places", places_path, class: ("current" if controller_name == "places") %> |
          <%= link_to "feed", feed_path, title: "Atom feed of new local posts" %> |
          <%= link_to "submit", "https://news.ycombinator.com/submitlink?#{{ t: "Show HN: " }.to_query}", title: "Post your local project as a Show HN" %>
        </nav>
      </header>

      <main>
        <%= yield %>
      </main>

      <footer class="site-footer">
        <p>
          Show HN projects tied to a city, town or county. Picked by a local model, so expect the odd mistake.<br>
          Posts from <a href="https://news.ycombinator.com/show">Hacker News</a> via <a href="https://hn.algolia.com/api">Algolia</a> |
          places from <a href="https://www.geonames.org/">GeoNames</a> (CC BY 4.0) |
          map &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> |
          contact <a href="mailto:morgan@morgz.org">morgan@morgz.org</a>
        </p>
        <%= form_with url: root_path, method: :get, class: "search", role: "search" do |f| %>
          <label for="q">Search places:</label>
          <%= f.search_field :q, id: "q", value: @query, "aria-label": "Search places" %>
        <% end %>
      </footer>
    </div>
  </body>
</html>
