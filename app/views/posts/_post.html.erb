<li class="post">
  <div class="post-title">
    <%= link_to post.short_title, post_link(post), rel: "nofollow noopener" %>
    <% if (host = post_host(post)) %><span class="host">(<%= host %>)</span><% end %>
  </div>
  <div class="post-meta">
    <%= pluralize(post.points, "point") %>
    <% if post.author %>by <%= link_to post.author, "https://news.ycombinator.com/user?id=#{CGI.escape(post.author)}" %><% end %>
    <time datetime="<%= post.posted_at.iso8601 %>" title="<%= post.posted_at.to_fs(:long) %>"><%= time_ago_in_words(post.posted_at) %> ago</time>
    <% if post.place && local_assigns[:show_place] != false %>| <%= link_to post.place.name, place_path(post.place), class: "place", title: post.place.label %><% end %>
    | <%= link_to(post.num_comments.zero? ? "discuss" : pluralize(post.num_comments, "comment"), hn_link(post)) %>
  </div>
</li>
