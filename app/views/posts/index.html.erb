<% content_for :title, @query.present? ? "#{@query} | Nearby Hacker News" : "Nearby Hacker News" %>

<div class="map-wrap">
<%= render "shared/map", places: @map_places %>

<% if @total > PostsController::MAP_LIMIT %>
  <% keep = { sort: (@sort if @sort == "top"), q: @query.presence } %>
  <% options = [ [ "#{@sort == "top" ? "top" : "newest"} #{PostsController::MAP_LIMIT}", false ], [ "all", true ] ] %>
  <p class="map-scope">
    <%= safe_join(options.map { |label, all| all == @map_all ? tag.b(label) : link_to(label, root_path(**keep, all: ("1" if all))) }, " | ") %>
  </p>
<% end %>
</div>

<% if @query.present? %>
  <p class="note"><%= pluralize(@total, "local post") %> matching “<%= @query %>” | <%= link_to "clear", root_path(sort: (@sort if @sort == "top")) %></p>
<% end %>

<% if @posts.any? %>
  <ol class="posts" start="<%= (@page - 1) * PostsController::PER_PAGE + 1 %>">
    <%= render partial: "posts/post", collection: @posts %>
  </ol>
  <%= render "shared/pager", page: @page, total: @total, per: PostsController::PER_PAGE %>
<% else %>
  <p class="empty"><%= @query.present? ? "Nothing local for “#{@query}” yet." : "No local posts yet. The first scrape fills this in." %></p>
<% end %>
