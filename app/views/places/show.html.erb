<% content_for :title, "#{@place.name} | Local Show HN" %>

<section class="place-head">
  <h1><%= @place.name %></h1>
  <p class="note">
    <%= @place.region %> |
    <%= pluralize(@posts.size, "post") %> about <%= @place.county? ? "this county and its towns" : "this #{@place.population >= 100_000 ? 'city' : 'town'}" %>
    <% if @county %>| in <%= link_to @county.name, place_path(@county) %><% end %>
  </p>
</section>

<% if @posts.any? %>
  <ol class="posts">
    <%= render partial: "posts/post", collection: @posts, locals: { show_place: @place.county? } %>
  </ol>
<% else %>
  <p class="empty">Nothing here yet.</p>
<% end %>

<% if @nearby.any? %>
  <p class="nearby">
    Nearby:
    <%= safe_join(@nearby.map { |place| safe_join([ link_to(place.name, place_path(place)), " ", tag.span("(#{place.posts_count})", class: "count") ]) }, " | ") %>
  </p>
<% end %>
