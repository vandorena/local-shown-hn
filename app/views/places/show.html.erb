<% content_for :title, "#{@place.name} | Nearby Hacker News" %>

<%= render "shared/map", places: @map_places, focus: @place %>

<section class="place-head">
  <h1><%= @place.name %></h1>
  <p class="note">
    <%= @place.region %> |
    <%= pluralize(@posts.size, "post") %> about
    <%= if @place.state? then "this state and its towns"
        elsif @place.county? then "this county and its towns"
        elsif @place.district? then "this district and its villages"
        else "this #{@place.population >= 100_000 ? 'city' : 'town'}"
        end %>
    <% if @district %>| in <%= link_to @district.name, place_path(@district) %><% end %>
    <% if @county %>| in <%= link_to @county.name, place_path(@county) %><% end %>
    <% if @state %>| in <%= link_to @state.name, place_path(@state) %><% end %>
  </p>
</section>

<% if @posts.any? %>
  <ol class="posts">
    <%= render partial: "posts/post", collection: @posts, locals: { show_place: !@place.town? } %>
  </ol>
<% else %>
  <p class="empty">Nothing here yet.</p>
<% end %>

<% if @nearby.any? %>
  <p class="nearby">
    Nearby:
    <%= safe_join(@nearby.map { |place| safe_join([ link_to(place.name, place_path(place)), " ", tag.span("(#{place.posts_count})", class: "count") ]) }, " | ") %>
  </p>
<% end %>
