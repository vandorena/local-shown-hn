<% content_for :title, "Places | Local Show HN" %>

<p class="note"><%= pluralize(@total, "local post") %> across <%= pluralize(@countries.sum { it.last.size }, "place") %> in <%= pluralize(@countries.size, "country") %>.</p>

<% @countries.each do |country, places| %>
  <section class="country">
    <h2><%= country %> <span class="count">(<%= places.sum(&:posts_count) %>)</span></h2>
    <% places.group_by(&:admin1_name).sort_by { |region, ps| [ -ps.sum(&:posts_count), region.to_s ] }.each do |region, in_region| %>
      <div class="region">
        <% if region.present? && region != country %><h3><%= region %></h3><% end %>
        <p class="place-list">
          <%= safe_join(in_region.sort_by { [ -it.posts_count, it.name ] }.map { |place| safe_join([ link_to(place.name, place_path(place)), " ", tag.span("(#{place.posts_count})", class: "count") ]) }, " | ") %>
        </p>
      </div>
    <% end %>
  </section>
<% end %>

<% if @countries.empty? %><p class="empty">No places yet.</p><% end %>
